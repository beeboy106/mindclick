{
  "expo": {
    "name": "Mindclick",
    "slug": "mindclick",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#f7f8fc"
    },
    "scheme": "mindclick",
    "android": {
      "package": "com.mindclick.app",
      "adaptiveIcon": {
        "backgroundColor": "#f7f8fc"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mindclick.app"
    },
    "plugins": [
      "expo-asset",
      "expo-dev-client",
      "@react-native-google-signin/google-signin"
    ]
  }
}
