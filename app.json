{
  "expo": {
    "name": "Mindclick",
    "slug": "mindclick",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "scheme": "mindclick",
    "android": {
      "package": "com.mindclick.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mindclick.app"
    },
    "plugins": [
      "expo-dev-client",
      "@react-native-google-signin/google-signin",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you pick profile pictures."
        }
      ],
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "bb1e085c-e4a5-4640-be6d-d3aa08b7074f"
      }
    }
  }
}
