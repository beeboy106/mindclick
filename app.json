{
  "expo": {
    "name": "Mindclick",
    "slug": "mindclick",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "https://raw.githubusercontent.com/beeboy106/mindclick/assets/assets/icon.png",
    "splash": {
      "image": "https://raw.githubusercontent.com/beeboy106/mindclick/assets/assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "scheme": "mindclick",
    "android": {
      "package": "com.mindclick.app",
      "adaptiveIcon": {
        "foregroundImage": "https://raw.githubusercontent.com/beeboy106/mindclick/assets/assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "https://raw.githubusercontent.com/beeboy106/mindclick/assets/assets/favicon.png"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mindclick.app"
    },
    "plugins": [
      "expo-dev-client",
      "@react-native-google-signin/google-signin",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you pick profile pictures."
        }
      ],
      "expo-notifications"
    ]
  }
}
